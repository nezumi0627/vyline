{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vyline Backend (Hono :3001)",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--watch", "Vyline/backend/src/index.ts"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "Vyline Frontend (Vite :5173)",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "Vyline/apps/desktop", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "Vyline Frontend (attach :5173)",
      "url": "http://127.0.0.1:5173"
    }
  ]
}
