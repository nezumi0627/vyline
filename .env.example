# Vyline / Nezu BOT — environment template
# Copy to `.env` at repo root (or export in your shell). Do NOT commit real secrets.

# ── Nezu BOT instruction channel (LINE Official Account → Cursor) ──
# Messaging API channel access token (long-lived or issued token)
NEZU_BOT_CHANNEL_TOKEN=

# Channel secret (webhook signature verification)
NEZU_BOT_CHANNEL_SECRET=

# Your LINE userId (U…) — filter inbound + default push destination
NEZU_BOT_USER_ID=

# Webhook listen port (default 8787)
# NEZU_BOT_PORT=8787

# Reply "分かりました" on receive (1/0, default 1)
# NEZU_BOT_AUTO_ACK=1

# Public HTTPS base for image push (ngrok / cloudflared URL, no trailing slash)
# Example: https://abcd.ngrok-free.app
# NEZU_BOT_PUBLIC_BASE=

# Override inbox directory (default: Vyline/backend/data/nezu-bot)
# NEZU_BOT_INBOX_DIR=
