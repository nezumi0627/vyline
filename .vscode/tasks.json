{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vyline: dev (backend + frontend)",
      "type": "shell",
      "command": "bun run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": []
    },
    {
      "label": "vyline: dev backend only",
      "type": "shell",
      "command": "bun run dev:backend",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": []
    },
    {
      "label": "vyline: dev frontend only",
      "type": "shell",
      "command": "bun run dev:frontend",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": []
    },
    {
      "label": "vyline: typecheck",
      "type": "shell",
      "command": "bun run typecheck",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$tsc"]
    }
  ]
}
