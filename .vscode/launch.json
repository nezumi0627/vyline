{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vyline: Backend (Bun)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--watch", "backend/src/index.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Vyline: Frontend (Vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/desktop", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Vyline: Full Dev",
      "configurations": ["Vyline: Backend (Bun)", "Vyline: Frontend (Vite)"]
    }
  ]
}
