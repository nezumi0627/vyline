{
  "name": "vyl",
  "version": "0.1.0",
  "description": "Short bunx entrypoint for the Vyline CLI.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/nezumi0627/vyline#readme",
  "repository": {
    "type": "git",
