{
  "name": "@vyline/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./stack": {
      "types": "./stack/_dist/client/mod.d.ts",
      "default": "./stack/client/mod.ts"
    },
    "./stack/assert": {
      "types": "./stack/assert.ts",
      "default": "./stack/assert.ts"
    },
    "./stack/base": {
      "types": "./stack/_dist/base/mod.d.ts",
      "default": "./stack/base/mod.ts"
    },
    "./stack/call": {
      "types": "./stack/_dist/client/features/call/mod.d.ts",
      "default": "./stack/client/features/call/mod.ts"
    },
    "./stack/storage": {
      "types": "./stack/_dist/base/storage/mod.d.ts",
      "default": "./stack/base/storage/mod.ts"
    },
    "./stack/thrift": {
      "types": "./stack/_dist/base/thrift/mod.d.ts",
      "default": "./stack/base/thrift/mod.ts"
    },
    "./call": "./src/call/index.ts",
    "./e2ee/pubCacheKeys": "./src/e2ee/pubCacheKeys.ts"
  },
  "scripts": {
    "delta": "bun ./src/tools/reportDesktopDelta.ts",
    "decrypt-edb": "bun ./src/tools/decryptDesktopEdb.ts",
    "extract-desktop-e2ee-keys": "bun ./src/tools/extractDesktopE2EEKeys.ts",
    "stack:types": "tsc -p stack/tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2",
    "@vyline/line-types": "workspace:*",
    "@vyline/loose-types": "workspace:*",
    "crypto-js": "^4.2.0",
    "curve25519-js": "^0.0.4",
    "node-bignumber": "^1.2.2",
    "node-int64": "^0.4.0",
    "opusscript": "^0.1.1",
    "thrift": "^0.20.0",
    "tweetnacl": "^1.0.3",
    "undici": "^7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.15.0",
    "@types/node-int64": "^0.4.32",
    "@types/thrift": "^0.10.17",
    "typescript": "^5.8.3"
  }
}
