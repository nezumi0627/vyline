{
  "name": "@vyline/ios-backup",
  "version": "0.1.0",
  "description": "iOS encrypted backup extraction for LINE chat history",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "lint": "eslint src --ext .ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  }
}
